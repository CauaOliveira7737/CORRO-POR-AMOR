{
  "expo": {
    "name": "Corro por Amor",
    "slug": "corro-por-amor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "owner": "cau4",
    "extra": {
      "eas": {
        "projectId": "dbd09472-cd0b-495a-8de2-5f6792d636d7"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cau4.corroporamor",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "O Corro por Amor precisa da sua localização GPS para registrar a distância, ritmo e percurso das suas corridas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O Corro por Amor registra a sua corrida com precisão em segundo plano mesmo com o celular no bolso ou tela bloqueada.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.cau4.corroporamor",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCvJk4nhuzk-hMWGjcF6Tu1lsfHhzHUnv0"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-web-browser",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyCvJk4nhuzk-hMWGjcF6Tu1lsfHhzHUnv0"
        }
      ]
    ]
  }
}
